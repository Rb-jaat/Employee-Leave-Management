digraph U { rankdir=LR; bgcolor="white"; fontname="Helvetica"; labelloc=t; fontsize=18; nodesep=0.28; ranksep=1.6; label="Use Case Diagram - Employee Leave Management - Krish Singh - IU2541230787"; node [fontname="Helvetica", fontsize=11];
