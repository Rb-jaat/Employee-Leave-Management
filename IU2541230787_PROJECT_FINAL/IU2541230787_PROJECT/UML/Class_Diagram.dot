edge [arrowhead=vee, color="#1565c0", fontcolor="#1565c0", style=solid];
LeaveRequest -> Employee [label="applied by\n*  ->  1", constraint=false];
Approval -> LeaveRequest [label="decides\n1  ->  1", constraint=false];
Approval -> Manager [label="decided by\n* -> 1", constraint=false];
edge [style=dashed, arrowhead=vee, color="#777777", fontcolor="#777777"];
Employee -> Date [label="joined_"]; LeaveRequest -> Date [label="from_/to_"]; Holiday -> Date; LeaveRequest -> LeavePolicy [label="type_ code (lookup)"]; FileManager -> Record [label="serialize()"];
