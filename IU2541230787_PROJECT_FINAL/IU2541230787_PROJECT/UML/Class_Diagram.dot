cancelLeave(req) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">+ balance(emp,type,year) : Balance</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">+ balanceReport() / departmentReport() / monthCalendar()</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">+ save() / load() / backup() / loadDemoData()</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
