PtrList_T [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#444444"><TR><TD BGCOLOR="#2e7d32"><FONT COLOR="white"><FONT POINT-SIZE="9">«template»</FONT><BR/><B>PtrList&lt;T&gt;</B></FONT></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">- data_ : T**</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">- size_ : int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">- cap_ : int</FONT></TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">+ add(T*) : void</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">+ operator[](i) : T*</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">+ removeAt(i) : bool</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">+ size() / capacity() : int</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">+ ~PtrList()  (delete[])</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">+ PtrList(const PtrList&amp;) = delete</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
