Record [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#444444"><TR><TD BGCOLOR="#6a3fb5"><FONT COLOR="white"><FONT POINT-SIZE="9">«abstract»</FONT><BR/><I>Record</I></FONT></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">- id_ : string</FONT></TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">+ id() : string</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">+ kind() : string {abstract}</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">+ display(os) : void {abstract}</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">+ row() : string {abstract}</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">+ serialize() : string {abstract}</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">+ matches(text) : bool</FONT></TD></TR><TR><TD ALIGN="LEFT" BORDER="0"><FONT POINT-SIZE="10">+ ~Record() {virtual}</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
